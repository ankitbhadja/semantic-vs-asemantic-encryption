{
  "name": "sf-portal-prospects-ms",
  "version": "1.0.0",
  "description": "Seaflux Portal - Prospects MS",
  "main": "server.js",
  "scripts": {
    "tsc": "tsc",
    "demo:encryption": "ts-node src/server/server.ts",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "lint-auto-fix": "eslint . --fix --ext .js,.jsx,.ts,.tsx",
    "start": "tsc && tsc-alias && node dist",
    "build": "tsc && tsc-alias",
    "env": "sync-dotenv",
    "liquibase": "cd liquibase && liquibase update",
    "liquibase-prod": "cd liquibase && liquibase update --defaultsFile=./liquibase-prod.properties",
    "liquibase-dev": "cd liquibase && liquibase update --defaultsFile=./liquibase-dev.properties",
    "pretty:check": "prettier --check \"./**/*.{js,jsx,ts,tsx,json,md}\"",
    "pretty:write": "prettier --write \"./**/*.{js,jsx,ts,tsx,json,md}\"",
    "upgrade-bridge": "yarn upgrade ssh://git@github-cj:curaJOY/mcj-ms-bridge.git"
  },
  "engines": {
    "npm": "`npm` is not support, Use `yarn`",
    "yarn": ">= 1.22.19",
    "node": ">=18.16.0 <=18"
  },
  "private": true,
  "author": "Seaflux Technologies",
  "license": "ISC",
  "dependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "class-validator": "^0.14.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.3.0",
    "express": "^4.18.2",
    "node-forge": "^1.3.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.3.1",
    "@types/node-cron": "^3.0.11",
    "@types/node-forge": "^1.3.11",
    "@typescript-eslint/eslint-plugin": "^5.59.11",
    "@typescript-eslint/parser": "^5.59.11",
    "esbuild": "^0.18.4",
    "lint-staged": "^14.0.1",
    "prettier": "^3.0.1",
    "sync-dotenv": "^2.7.0",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.7",
    "tslint": "^6.1.3",
    "typescript": "5.0.4"
  }
}
